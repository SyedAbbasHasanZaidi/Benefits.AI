# Supabase — Sydney region (ap-southeast-2)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AWS Bedrock — Sydney region
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Find available Claude model IDs in: AWS Console > Bedrock > Model catalog > ap-southeast-2
# Example: us.anthropic.claude-sonnet-4-5-20250514-v1:0 (update to available Claude 4 ID)
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250514-v1:0

# Voyage AI (embeddings — no AU endpoint; only public/non-PII text is embedded)
VOYAGE_API_KEY=your-voyage-api-key

# Rules service
RULES_SERVICE_URL=http://localhost:8001
