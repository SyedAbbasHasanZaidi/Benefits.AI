# ── Anthropic (LLM) ───────────────────────────────────────────────────────────
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model to use. Defaults to claude-sonnet-4-6 if not set.
# ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# ── Voyage AI (embeddings) ─────────────────────────────────────────────────────
# Used to embed the user query before pgvector search.
# Get a key at https://dash.voyageai.com
VOYAGE_API_KEY=

# ── Supabase (pgvector + sessions) ────────────────────────────────────────────
# Project URL and anon key from Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Rules service ──────────────────────────────────────────────────────────────
# URL of the FastAPI rules service. Defaults to localhost:8001.
RULES_SERVICE_URL=http://localhost:8001
