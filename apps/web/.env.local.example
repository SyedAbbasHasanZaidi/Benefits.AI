# ── Anthropic (LLM) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_ID=claude-sonnet-4-6

# ── Voyage AI (embeddings) ─────────────────────────────────────────────────────
VOYAGE_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — required for /api/account DELETE (admin user-deletion).
# Get from Supabase dashboard → Settings → API → service_role. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

# ── Rules service ──────────────────────────────────────────────────────────────
RULES_SERVICE_URL=http://localhost:8001

# ── Resend (account data export emails) ───────────────────────────────────────
# Get a key at https://resend.com (free tier covers personal-volume exports).
# Optional — if absent, /api/account/export returns 500.
RESEND_API_KEY=
RESEND_FROM=Benefits.AI <noreply@yourdomain.com>
